# ==============================================================================
# Hydroponic Nutrition AI - Environment Variables Template (.env.example)
# Copy this file to .env and customize values for local development.
# ==============================================================================

# Application Environment (dev | demo | test)
ENVIRONMENT=dev

# Server & Network Configuration
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Connection & Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=hydroponics
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/hydroponics

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Model Registry and Data Paths
MODEL_REGISTRY_PATH=models/manifests
IMAGE_DATA_PATH=image_data
SENSOR_DATA_PATH=sensor_data
PROCESSED_DATA_PATH=processed_data

# Campus Server & Camera Integration (IP/Endpoints kept in .env only, never committed)
CAMPUS_SERVER_URL=http://127.0.0.1:8080
CAMPUS_CAMERA_URL=http://127.0.0.1:8080/feed
CAMPUS_POLL_INTERVAL_S=30
CAMPUS_MAX_AGE_S=120
CAMPUS_REQUEST_TIMEOUT_S=5

# Upload & Model Inference Limits
MAX_UPLOAD_MB=15
DEVICE_ADAPTER=mock
FORCE_CPU=false
SAM2_CHECKPOINT=models/image/sam2_hiera_small.pt
SAM2_CONFIG=sam2_hiera_s.yaml
